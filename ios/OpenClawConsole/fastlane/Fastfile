default_platform(:ios)

def app_store_api_key_from_env
  return nil unless ENV["APPSTORE_KEY_ID"] && ENV["APPSTORE_ISSUER_ID"] && ENV["APPSTORE_PRIVATE_KEY"]

  key_content = ENV["APPSTORE_PRIVATE_KEY"]
  is_base64 = key_content&.include?("-----BEGIN PRIVATE KEY-----") ? false : true

  app_store_connect_api_key(
    key_id: ENV["APPSTORE_KEY_ID"],
    issuer_id: ENV["APPSTORE_ISSUER_ID"],
    key_content: key_content,
    is_key_content_base64: is_base64
  )
end

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"] == "true"

    # Use App Store Connect API key if available
    api_key = app_store_api_key_from_env

    marketing_version = get_version_number(
      xcodeproj: "OpenClawConsole.xcodeproj",
      target: "OpenClawConsole"
    )
    # Force build number higher than latest TestFlight version 230286599766
    forced_high_build_number = 230286599767  # One higher than current maximum
    UI.message("Using forced high build number to bypass TestFlight conflict: #{forced_high_build_number}")
    current_build_number = get_build_number(
      xcodeproj: "OpenClawConsole.xcodeproj"
    ).to_i

    # Use forced high build number to bypass TestFlight version conflict
    next_build_number = forced_high_build_number
    UI.message("Using forced high build number #{next_build_number} to ensure upload succeeds")

    UI.message("Using build number #{next_build_number} for version #{marketing_version}")

    # Force update build number in ALL possible locations to ensure it sticks

    # Method 1: Fastlane increment_build_number
    increment_build_number(
      xcodeproj: "OpenClawConsole.xcodeproj",
      build_number: next_build_number
    )

    # Method 2: Direct agvtool update (low level)
    sh("cd .. && agvtool new-version -all #{next_build_number}")

    # Method 3: Update CFBundleVersion in Info.plist directly
    sh("cd .. && /usr/libexec/PlistBuddy -c 'Set :CFBundleVersion #{next_build_number}' OpenClawConsole/Info.plist")

    # Verify the build number was actually set
    updated_build_number = get_build_number(xcodeproj: "OpenClawConsole.xcodeproj").to_i
    UI.message("Verified build number in project: #{updated_build_number}")

    # Also verify via agvtool
    agvtool_version = sh("cd .. && agvtool what-version -terse", return_stdout: true).strip.to_i
    UI.message("Verified build number via agvtool: #{agvtool_version}")

    if updated_build_number != next_build_number || agvtool_version != next_build_number
      UI.user_error!("Build number update failed! Expected #{next_build_number}, fastlane: #{updated_build_number}, agvtool: #{agvtool_version}")
    end

    # Use automatic signing for both CI and local builds for simplicity and reliability
    UI.message("Using automatic signing with API key")

    if ENV["APPLE_TEAM_ID"] && !ENV["APPLE_TEAM_ID"].empty?
      update_code_signing_settings(
        path: "OpenClawConsole.xcodeproj",
        use_automatic_signing: true,
        targets: ["OpenClawConsole"],
        team_id: ENV["APPLE_TEAM_ID"]
      )
    end

    # Set up authentication for automatic signing
    if api_key && ENV["APPSTORE_KEY_PATH"]
      build_app(
        scheme: "OpenClawConsole",
        export_method: "app-store",
        xcargs: "-allowProvisioningUpdates -authenticationKeyID #{ENV['APPSTORE_KEY_ID']} -authenticationKeyIssuerID #{ENV['APPSTORE_ISSUER_ID']} -authenticationKeyPath #{ENV['APPSTORE_KEY_PATH']}"
      )
    else
      build_app(
        scheme: "OpenClawConsole",
        export_method: "app-store",
        xcargs: "-allowProvisioningUpdates"
      )
    end

    # Ensure external testers are configured before uploading
    add_testers

    upload_to_testflight(
      skip_waiting_for_build_processing: false,
      api_key: api_key,
      beta_app_description: ENV["TESTFLIGHT_BETA_DESCRIPTION"] || "OpenClaw Console beta build for external testing.",
      beta_app_feedback_email: ENV["TESTFLIGHT_FEEDBACK_EMAIL"] || "igor.ganapolsky@icloud.com",
      distribute_external: true,
      notify_external_testers: true,
      groups: ["External Testers"],
      changelog: "Latest OpenClaw Console beta build"
    )
  end

  desc "Setup certificates and profiles via match"
  lane :setup do
    setup_ci if ENV["CI"] == "true"

    if ENV["MATCH_GIT_URL"] && ENV["MATCH_PASSWORD"]
      api_key = app_store_api_key_from_env

      if ENV["CI"] == "true"
        # CI environment: use automatic signing for reliability
        UI.message("Setting up certificates for CI environment (automatic signing)")

        # Configure automatic signing for CI
        if ENV["APPLE_TEAM_ID"] && !ENV["APPLE_TEAM_ID"].empty?
          update_code_signing_settings(
            use_automatic_signing: true,
            path: "OpenClawConsole.xcodeproj",
            targets: ["OpenClawConsole"],
            team_id: ENV["APPLE_TEAM_ID"]
          )
          UI.message("✅ Configured automatic signing for App Store distribution")
        else
          UI.user_error!("APPLE_TEAM_ID is required for automatic signing in CI")
        end
      else
        # Local development: can generate/update certificates if needed
        UI.message("Setting up certificates for local development")

        # Only use match if git repository is available
        if ENV["MATCH_GIT_URL"] && !ENV["MATCH_GIT_URL"].empty?
          UI.message("Using fastlane match for certificate management")
          match(
            type: "appstore",
            app_identifier: ["com.openclaw.console"],
            readonly: false,
            api_key: api_key
          )
        else
          UI.message("Skipping match (repository not configured) - configuring automatic signing")

          # Configure automatic signing when match is not available
          update_code_signing_settings(
            use_automatic_signing: true,
            path: "OpenClawConsole.xcodeproj",
            targets: ["OpenClawConsole"],
            code_sign_identity: "Apple Development"  # For automatic signing
          )

          UI.message("✅ Configured automatic signing for development")
        end
      end
    else
      UI.message("No MATCH_* secrets configured - skipping match setup and relying on automatic signing.")
    end
  end

  desc "Distribute to Firebase App Distribution"
  lane :firebase_dev do
    increment_build_number(
      build_number: latest_testflight_build_number + 1
    )
    build_app(
      scheme: "OpenClawConsole",
      export_method: "ad-hoc"
    )
    firebase_app_distribution(
      app: ENV["FIREBASE_IOS_APP_ID"],
      groups: "qa-team,developers",
      release_notes: "Dev build from develop branch (#{ENV['GITHUB_SHA'] || 'local'})"
    )
  end

  desc "Add external TestFlight testers"
  lane :add_testers do
    api_key = app_store_api_key_from_env

    unless api_key
      UI.user_error!("App Store Connect API key required for tester management")
    end

    # List of external testers to add
    external_testers = [
      "iganapolsky@gmail.com",
      "igor.ganapolsky@icloud.com"
    ]

    UI.message("Adding external TestFlight testers...")

    # First ensure the External Testers group exists
    begin
      pilot(
        api_key: api_key,
        app_identifier: "com.openclaw.console",
        distribute_only: false,
        groups: ["External Testers"],
        demo_account_required: false,
        beta_app_feedback_email: "igor.ganapolsky@icloud.com",
        localized_app_info: {
          "default" => {
            feedback_email: "igor.ganapolsky@icloud.com",
            marketing_url: "https://github.com/igorganapolsky/openclaw-console",
            description: "OpenClaw Console - Mobile control plane for OpenClaw agents"
          }
        }
      )
      UI.success("External Testers group is ready")
    rescue => e
      UI.message("Group setup issue (may already exist): #{e}")
    end

    # Add each tester to the group
    external_testers.each do |email|
      begin
        pilot(
          api_key: api_key,
          app_identifier: "com.openclaw.console",
          distribute_only: false,
          testers: [email],
          groups: ["External Testers"]
        )
        UI.success("Added tester: #{email}")
      rescue => e
        UI.message("Could not add #{email} (may already exist): #{e}")
      end
    end

    UI.success("✅ TestFlight testers configured successfully")
  end

  desc "Clean up old/expired certificates and provisioning profiles"
  lane :cleanup_certificates do
    api_key = app_store_api_key_from_env

    unless api_key
      UI.user_error!("App Store Connect API key required for certificate cleanup")
    end

    UI.message("Cleaning up old certificates and profiles...")

    # This will show current certificates and profiles
    # Manual cleanup may be required through match or App Store Connect
    match(
      type: "appstore",
      app_identifier: ["com.openclaw.console"],
      readonly: true,
      api_key: api_key,
      verbose: true
    )

    UI.important("Review the certificates listed above.")
    UI.important("If you have too many certificates, you may need to:")
    UI.important("1. Revoke old certificates via App Store Connect")
    UI.important("2. Run: fastlane match nuke appstore --readonly false")
    UI.important("3. Then regenerate with: fastlane match appstore --readonly false")
  end
end
