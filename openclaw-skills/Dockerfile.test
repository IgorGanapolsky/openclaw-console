FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install ALL dependencies for running from source
RUN npm install

# Copy source code
COPY src/ ./src/
COPY tsconfig.json ./

# Install ts-node for running TypeScript directly
RUN npm install -g ts-node

# Create startup script that runs from source
RUN echo '#!/bin/sh' > start.sh && \
    echo 'echo "Starting OpenClaw Gateway with Multica integration (from source)..."' >> start.sh && \
    echo 'ts-node src/index.ts' >> start.sh && \
    chmod +x start.sh

EXPOSE 18789

CMD ["sh", "./start.sh"]