{
  "name": "@openclaw-console/skills",
  "version": "1.0.0",
  "description": "OpenClaw Work Console server-side skills and gateway",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "pair": "node scripts/pair.mjs",
    "pair:server": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --passWithNoTests",
    "lint": "eslint src tests --ext .ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@revenuecat/purchases-js": "^1.35.0",
    "@slack/oauth": "^3.0.5",
    "@slack/web-api": "^7.15.1",
    "express": "^5.2.1",
    "fast-xml-builder": "^1.2.0",
    "firebase-admin": "^13.10.0",
    "node-fetch": "^3.3.2",
    "protobufjs": "^8.4.0",
    "qrcode": "^1.5.4",
    "redis": "^5.11.0",
    "simple-git": "^3.36.0",
    "uuid": "^14.0.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.2.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "overrides": {
    "@types/request": {
      "form-data": "^2.5.6"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json",
          "useESM": true
        }
      ]
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
