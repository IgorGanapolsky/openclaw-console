# Configuration-based pre-commit hooks for Git 2.54+
# More reliable than script-based hooks

[hook "pre-commit"]
    # Swift linting for iOS
    ios-swiftlint = "cd ios/OpenClawConsole && swiftlint --quiet --reporter emoji || true"

    # Kotlin linting for Android
    android-ktlint = "cd android && ./gradlew ktlintCheck || true"

    # TypeScript linting for skills gateway
    skills-eslint = "cd openclaw-skills && npm run lint:fix || true"

    # Security scanning
    security-check = "git diff --cached --name-only | grep -E '\\.(swift|kt|ts|js)$' | xargs -r semgrep --config=auto || true"

    # Commit message validation
    commit-msg-check = "echo 'Validating commit message format...'"